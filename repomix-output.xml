    /**
     * Count events for a signal.
     */
    long countBySignalId(String signalId);

    /**
     * Get last event sequence for a signal.
     */
    @Query("SELECT MAX(e.sequence) FROM ExecutionEventEntity e WHERE e.signalId = :signalId")

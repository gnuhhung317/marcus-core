{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Capture Request - Contract v2",
  "type": "object",
  "required": ["signalId","botId","symbol","action","marketType","orderType","generatedTimestamp"],
  "properties": {
    "signalId": {"type":"string","description":"Client-side idempotency id (UUID/ULID)"},
    "botId": {"type":"string"},
    "symbol": {"type":"string","description":"Trading pair, CCXT format (BTC/USDT)"},
    "action": {"type":"string","enum":["OPEN_LONG","OPEN_SHORT","CLOSE_LONG","CLOSE_SHORT","CLOSE"]},
    "marketType": {"type":"string","enum":["SPOT","FUTURE","MARGIN"]},
    "orderType": {"type":"string","enum":["LIMIT","MARKET","STOP_LIMIT","TAKE_PROFIT"]},
    "entry": {"type":["number","null"],"description":"Entry price required when orderType=LIMIT"},
    "stopLoss": {"type":["number","null"]},
    "takeProfit": {"type":["number","null"]},
    "amount": {"type":["number","null"]},
    "leverage": {"type":["integer","null"],"minimum":1,"maximum":125},
    "marginMode": {"type":["string","null"],"enum":["CROSS","ISOLATED"]},
    "reduceOnly": {"type":["boolean","null"]},
    "generatedTimestamp": {"type":"string","format":"date-time"},
    "timeframe": {"type":["string","null"]},
    "metadata": {"type":"object","additionalProperties":true}
  },
  "additionalProperties": false,
  "examples": [
    {
      "signalId":"b8d9f9c2-6d2f-4f2a-8a5b-0a1b2c3d4e5f",
      "botId":"bot_f25c000d5e90",
      "symbol":"BTC/USDT",
      "action":"OPEN_LONG",
      "marketType":"SPOT",
      "orderType":"LIMIT",
      "entry":30000.0,
      "stopLoss":28000.0,
      "takeProfit":33000.0,
      "amount":0.001,
      "generatedTimestamp":"2026-05-24T06:30:00Z",
      "metadata": {"confidence_score":0.82,"strategy":"sma_v1"}
    }
  ]
}
